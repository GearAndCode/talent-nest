# ============================================================
# App environment
# ============================================================
# "sandbox" or "production". Controls which PayFast host is used by
# default and turns on strict startup validation of PayFast credentials.
# Anything other than "production" (unset, "sandbox", "development", etc.)
# is treated as sandbox - it is never silently treated as production.
ENVIRONMENT=sandbox

# ============================================================
# Database
# ============================================================
DATABASE_URL=postgresql://user:password@localhost:5432/talentnest

# ============================================================
# JWT Authentication
# ============================================================
SECRET_KEY=changeme-generate-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============================================================
# OpenAI
# ============================================================
OPENAI_API_KEY=sk-changeme

# ============================================================
# Google OAuth (Optional)
# ============================================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=changeme

# ============================================================
# Gmail SMTP (OTP Emails)
# ============================================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=changeme@example.com
MAIL_PASSWORD=changeme
MAIL_FROM=changeme@example.com

# ============================================================
# OTP Configuration
# ============================================================
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10

# ============================================================
# SaaS Billing / Payment Gateway (PayFast Pakistan)
# ============================================================
# Only "payfast" is supported today.
PAYMENT_PROVIDER=payfast

# --- Sandbox (ENVIRONMENT=sandbox) ---------------------------------
# Get these from your PayFast merchant dashboard's sandbox/test
# credentials (see https://gopayfast.com for onboarding). Placeholders
# below are safe, non-functional examples only.
#
# PAYMENT_MERCHANT_ID=your-sandbox-merchant-id
# PAYMENT_SECRET=your-sandbox-secured-key
# PAYMENT_WEBHOOK_SECRET=your-sandbox-webhook-secret
# PAYMENT_API_BASE_URL=https://ipguat.apps.net.pk
# FRONTEND_BASE_URL=http://localhost:5173
# BACKEND_BASE_URL=http://localhost:8000

# --- Production (ENVIRONMENT=production) ---------------------------
# All of these are REQUIRED when ENVIRONMENT=production - the backend
# will refuse to start without them (see app/config.py:validate_payment_config).
# Never commit real values; set these in your hosting provider's secret
# manager (Render/Fly/etc.), not in a committed .env file.
PAYMENT_MERCHANT_ID=changeme-production-merchant-id
PAYMENT_SECRET=changeme-production-secured-key
PAYMENT_WEBHOOK_SECRET=changeme-production-webhook-secret

# Optional: only set this if your PayFast integration tier issued a
# separate API key on top of the merchant ID + secured key above.
PAYMENT_API_KEY=

# PayFast's live host. Leave unset in sandbox (it defaults correctly based
# on ENVIRONMENT); in production it defaults to this same value, but it is
# listed explicitly here so it's never accidentally left pointing at
# sandbox. Confirm this matches your merchant onboarding docs/dashboard.
PAYMENT_API_BASE_URL=https://ipg1.apps.net.pk

# Must be your real production URLs - "localhost" is rejected in
# production by validate_payment_config().
FRONTEND_BASE_URL=https://app.talentnest.example.com
BACKEND_BASE_URL=https://api.talentnest.example.com
