# Public Google Identity Services client ID (safe to expose in the browser).
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Public Azure AD app registration values (safe to expose in the browser).
VITE_AZURE_CLIENT_ID=your-azure-client-id
VITE_AZURE_TENANT_ID=common

# Base URL of the TalentNest backend API.
#   Local dev:   http://127.0.0.1:8000
#   Production:  https://api.talentnest.example.com
VITE_API_BASE_URL=http://127.0.0.1:8000

# NOTE: No PayFast credentials belong here. The frontend never sees
# PayFast merchant IDs, secured keys, or webhook secrets - it only
# receives a one-time checkout_url from POST /checkout and redirects
# the browser to it. All PayFast config lives in the backend's .env.
